# VITPAY API — configuration locale (développement). Ne JAMAIS committer de vrais secrets.
NODE_ENV=development
PORT=4710
# Rôle applicatif (sans BYPASSRLS, sans droits UPDATE/DELETE sur les tables immuables)
DATABASE_URL=postgres://vitpay_app:dev_app_password_change_me@localhost:5433/vitpay
# Rôle système (BYPASSRLS) — chemins transverses : auth, page publique, webhooks, admin, workers
DATABASE_SYSTEM_URL=postgres://vitpay_system:dev_system_password_change_me@localhost:5433/vitpay
# Rôle propriétaire (migrations uniquement)
DATABASE_OWNER_URL=postgres://vitpay_owner:dev_owner_password_change_me@localhost:5433/vitpay
# 32 octets base64 — générer avec : openssl rand -base64 32
APP_ENCRYPTION_KEY=REPLACE_WITH_openssl_rand_base64_32
# Rotation uniquement : anciennes clés, séparées par des virgules (déchiffrement seul)
APP_ENCRYPTION_KEYS_PREVIOUS=
PUBLIC_API_URL=http://localhost:4710
PAY_BASE_URL=http://localhost:3710
BUSINESS_APP_URL=http://localhost:3711
# E-mails : log (développement) ou smtp (ex. Mailpit : smtp://localhost:1025)
EMAIL_TRANSPORT=log
ALLOWED_ORIGINS=http://localhost:3710,http://localhost:3711,http://localhost:3712
COOKIE_SECURE=false
WORKERS_ENABLED=true
MOCK_PSP_ENABLED=true
# Webhooks sortants vers localhost/HTTP : développement uniquement (interdit en production)
ALLOW_PRIVATE_WEBHOOK_URLS=true
# Garde-fou réglementaire : reste à false tant que docs/COMPLIANCE.md n'est pas entièrement validé.
PAYMENTS_LIVE_ENABLED=false
# LEGAL_SIGNOFF_REF=
